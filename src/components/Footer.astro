---
const anio = new Date().getFullYear();
---

<footer class="pie">
  <p class="pie__creditos">
    Datos de <a href="https://www.tvmaze.com/api" target="_blank" rel="noopener">TVmaze API</a>
     · Hecho con <a href="https://astro.build" target="_blank" rel="noopener">Astro</a> · {anio}
  </p>
</footer>

<style>
  /* Sin barra: el crédito queda suelto en la esquina inferior derecha */
  .pie {
    display: flex;
    justify-content: flex-end;
    width: min(100% - 2.5rem, var(--ancho-max));
    margin-inline: auto;
    padding-block: 1.5rem 2rem;
  }

  .pie__creditos {
    font-size: 0.82rem;
    color: var(--texto-suave);
    opacity: 0.75;
    transition: opacity var(--transicion);
  }

  .pie__creditos:hover {
    opacity: 1;
  }

  @media (max-width: 520px) {
    .pie {
      justify-content: center;
      text-align: center;
    }
  }
</style>
